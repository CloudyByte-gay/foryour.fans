generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// The DID is the canonical identity. Never use the mutable AT handle as the
/// primary identity — `handle` and `displayName` are cached, mutable profile
/// data resolved from the user's own PDS (see prompts/full.md "Hosting model").
model User {
  id          String   @id @default(uuid()) @db.Uuid
  did         String   @unique
  handle      String?
  displayName String?
  avatarUrl   String?
  bannerUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator Creator?

  /// The active PaymentProvider's customer id for this user, created once
  /// on first subscribe and reused for every subsequent one. Nullable, not
  /// a separate table: today there's only ever one active provider (see
  /// prompts/full.md's Phase 6 note) — if that ever changes to concurrently
  /// running multiple providers, this becomes a join table then.
  paymentCustomerId String?

  subscriptions Subscription[]

  contentKeyGrants ContentKeyGrant[]

  @@map("users")
}

enum CreatorStatus {
  ACTIVE
  SUSPENDED
}

/// Elevated from "future work" to a real field now per prompts/full.md's
/// Phase 14 note (adult content is in scope): gates payout onboarding
/// (Phase 6) and adult-content posting (Phase 14) before those exist, so
/// this doesn't need a migration bolted on later.
enum CreatorVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
}

/// Only operational/internal fields plus a CACHE of the public AT record —
/// never the source of truth for displayName/bio/website. The source of
/// truth is the fans.foryour.profile record on the creator's own PDS; see
/// docs/atproto-vs-database.md. Every write to displayName/bio/website here
/// happens only after successfully writing the AT record (write-through),
/// never before — see apps/api/src/services/creators.ts.
///
/// There is NO app-owned name here — no slug, no username. The public
/// identity is the AT handle (cached on `User.handle`, keyed by DID); the
/// durable key is `did`. A creator's page is `/c/<handle>` or `/c/<did>`.
/// See docs/architecture.md "Creator page address".
model Creator {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id])
  did    String @unique

  /// Cached mirror of fans.foryour.profile — see model doc comment above.
  displayName String?
  bio         String?
  website     String?
  /// Site-only image overrides. Null means use the cached public AT/Bluesky
  /// image from User; setting a value never writes back to the creator's PDS.
  avatarUrl   String?
  bannerUrl   String?

  status             CreatorStatus             @default(ACTIVE)
  verificationStatus CreatorVerificationStatus @default(UNVERIFIED)

  /// Creator-owned PDS rearchitecture (see prompts/creator-owned-pds.md,
  /// docs/creator-owned-pds.md). These are cache/portability bookkeeping —
  /// null on every pre-rearchitecture row, populated by
  /// CreatorOwnedContentRepository writes and the migrate-to-pds script.
  /// `pdsUrl` is the resolved PDS service endpoint, cached for the
  /// portability panel. `profileSourceUri`/`Cid` point at the authoritative
  /// fans.foryour.profile record; `serviceConfigUri` at fans.foryour.serviceConfig.
  pdsUrl           String?
  profileSourceUri String?
  profileSourceCid String?
  serviceConfigUri String?
  pdsSyncedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tiers         SubscriptionTier[]
  subscriptions Subscription[]
  payoutAccount PayoutAccount?
  posts         Post[]
  handleHistory CreatorHandleHistory[]
  mediaAssets   MediaAsset[]
  contentKeys   ContentKey[]

  @@map("creators")
}

/// Append-only log of AT handles a creator's DID has previously published.
/// When `syncUserFromProfile` (packages/auth) sees a creator's handle change
/// at login, it appends the *previous* handle here before overwriting
/// `User.handle`. `GET /creators/:identifier` consults it so an old
/// `/c/<oldhandle>` link 301-redirects to the current handle instead of
/// 404ing (see apps/api/src/services/creators.ts#resolveCreatorByIdentifier
/// and docs/architecture.md "Creator page address"). `did` is denormalized
/// so a stale-handle lookup needs no join. Rows are tiny and kept
/// indefinitely.
model CreatorHandleHistory {
  id             String   @id @default(uuid()) @db.Uuid
  creatorId      String   @db.Uuid
  creator        Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  did            String
  previousHandle String
  recordedAt     DateTime @default(now())

  @@index([previousHandle])
  @@index([did])
  @@map("creator_handle_history")
}

/// Mirrors fans.foryour.tier — see docs/atproto-vs-database.md. Every field
/// here except `isActive`/`atRkey` is part of that public AT record; any
/// change to name/description/priceCents/currency/sortOrder republishes it
/// (see packages/subscriptions/src/tiers.ts). Rows are NEVER deleted, only
/// deactivated — a Subscription references a tier's row forever, including
/// tiers a creator has since retired, and SubscriptionTier.priceCents must
/// never retroactively change what an existing subscriber is billed (their
/// agreed price is snapshotted onto the Subscription row at subscribe
/// time, not read live from here — see Subscription below).
model SubscriptionTier {
  id        String  @id @default(uuid()) @db.Uuid
  creatorId String  @db.Uuid
  creator   Creator @relation(fields: [creatorId], references: [id])

  name        String
  description String?
  priceCents  Int
  currency    String  @db.Char(3)
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  /// The tid rkey of the corresponding fans.foryour.tier record on the
  /// creator's own PDS — generated once (packages/atproto's nextTid()) and
  /// reused for every update/delete of this same record.
  atRkey String @unique

  /// Creator-owned PDS rearchitecture: the authoritative fans.foryour.tier
  /// record's AT URI/CID. Null on pre-rearchitecture rows; once set, this
  /// row is a cache (`isAuthoritative` false) of a PDS-owned record.
  sourceUri       String? @unique
  sourceCid       String?
  isAuthoritative Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
  gatedPosts    Post[]
  contentKeys   ContentKey[]

  @@map("subscription_tiers")
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

/// `provider` is a string, not an enum — the whole point of PaymentProvider
/// (packages/subscriptions/src/providers/types.ts) is that the domain isn't
/// coupled to a specific processor; only "fake" exists right now (see
/// prompts/full.md's Phase 6 note on why Stripe can't be assumed for a
/// platform that supports adult content). `priceCentsAtSubscription`/
/// `currencyAtSubscription` are the price the subscriber actually agreed to
/// — canAccess and revenue reporting must read these, never
/// `tier.priceCents` live, per the grandfathering rule (see SubscriptionTier
/// above and docs/architecture.md).
model Subscription {
  id String @id @default(uuid()) @db.Uuid

  subscriberUserId String @db.Uuid
  subscriberUser   User   @relation(fields: [subscriberUserId], references: [id])

  creatorId String  @db.Uuid
  creator   Creator @relation(fields: [creatorId], references: [id])

  tierId String           @db.Uuid
  tier   SubscriptionTier @relation(fields: [tierId], references: [id])

  status SubscriptionStatus @default(PENDING)

  provider               String
  providerSubscriptionId String?

  priceCentsAtSubscription Int
  currencyAtSubscription   String @db.Char(3)

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerSubscriptionId])
  @@index([subscriberUserId, creatorId])
  @@map("subscriptions")
}

/// Idempotency ledger for provider webhooks — `[provider, providerEventId]`
/// is the dedupe key. `processedAt` is null the instant the row is
/// upserted and only set once side effects (Subscription status updates)
/// have actually completed, so a crash mid-processing leaves a row a retry
/// can detect and finish rather than skip — see
/// packages/subscriptions/src/webhooks.ts.
model PaymentEvent {
  id String @id @default(uuid()) @db.Uuid

  provider        String
  providerEventId String
  type            String
  payload         Json

  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([provider, providerEventId])
  @@map("payment_events")
}

enum PayoutAccountStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  RESTRICTED
}

/// One payout account per creator per provider. A creator can publish and
/// receive subscriptions while this is PENDING/NOT_STARTED — per
/// prompts/full.md's Phase 6 note, only real payout *figures* (Phase 13)
/// are gated on VERIFIED, not the ability to have subscribers at all.
model PayoutAccount {
  id String @id @default(uuid()) @db.Uuid

  creatorId String  @unique @db.Uuid
  creator   Creator @relation(fields: [creatorId], references: [id])

  provider          String
  providerAccountId String?
  status            PayoutAccountStatus @default(NOT_STARTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payout_accounts")
}

enum PostVisibility {
  PUBLIC
  SUBSCRIBERS
  TIER
}

/// The private-content model (Phase 7) — see docs/atproto-vs-database.md and
/// packages/content. `text` here is the actual body for every visibility;
/// unlike Creator/SubscriptionTier, this is NOT a cache of an AT record for
/// SUBSCRIBERS/TIER posts — for those, Postgres is the only copy, full stop
/// (see the "explicitly, permanently forbidden" list in
/// docs/atproto-vs-database.md: a paid post's body must never be publishable
/// data). Only a PUBLIC post also has a fans.foryour.post AT record, tracked
/// by `atRkey`; see packages/content/src/repository.ts for the publish/
/// retract logic on visibility transitions.
model Post {
  id String @id @default(uuid()) @db.Uuid

  creatorId String  @db.Uuid
  creator   Creator @relation(fields: [creatorId], references: [id])

  visibility PostVisibility

  /// Required (and only meaningful) when visibility is TIER — the minimum
  /// SubscriptionTier (by sortOrder) required to view this post; see
  /// packages/subscriptions/src/entitlements.ts#canAccess. Null for
  /// PUBLIC/SUBSCRIBERS. Deliberately NOT cascade-restricted: a tier can be
  /// deactivated (never hard-deleted, see SubscriptionTier above) while
  /// still gating existing posts.
  minimumTierId String?           @db.Uuid
  minimumTier   SubscriptionTier? @relation(fields: [minimumTierId], references: [id])

  /// The post body. For a pre-rearchitecture row this is the only copy
  /// (SUBSCRIBERS/TIER) or a write-through cache of the fans.foryour.post
  /// record (PUBLIC). Once `isAuthoritative` is false the PDS record is the
  /// source of truth and this is a rebuildable cache — for a gated post it
  /// then holds cleartext ONLY transiently (it is cleared once the encrypted
  /// PDS record is confirmed; see CreatorOwnedContentRepository).
  text String

  /// The tid rkey of the mirrored fans.foryour.post record — set only while
  /// visibility is PUBLIC, null otherwise. Reused across edits that keep the
  /// post PUBLIC, cleared (after retracting the AT record) the moment a post
  /// stops being PUBLIC — see packages/content/src/repository.ts.
  atRkey String? @unique

  /// Creator-owned PDS rearchitecture (see prompts/creator-owned-pds.md).
  /// `sourceUri`/`sourceCid`: the authoritative fans.foryour.post record.
  /// `bskyUri`/`bskyCid`: the paired app.bsky.feed.post for a dual-published
  /// public post. `isAuthoritative` flips to false once the PDS holds the
  /// record; `indexedAt`/`cacheExpiresAt` drive cache freshness.
  /// `accessPolicyUri`: the fans.foryour.accessPolicy record for a gated post.
  sourceUri       String?   @unique
  sourceCid       String?
  bskyUri         String?   @unique
  bskyCid         String?
  /// Bluesky-public-posts refactor (prompts/bluesky-public-posts.md,
  /// docs/bluesky-public-posts.md). `bskyRkey`: the tid rkey of the paired
  /// app.bsky.feed.post — generated once and reused across edits, exactly
  /// like `atRkey` for the fans.foryour.post mirror; null unless the post is
  /// PUBLIC and dual-published. `canonicalUri`: which paired record is
  /// canonical for display/dedupe (this app always uses the fans.foryour.post
  /// URI).
  bskyRkey        String?   @unique
  canonicalUri    String?
  accessPolicyUri String?
  isAuthoritative Boolean   @default(true)
  indexedAt       DateTime?
  cacheExpiresAt  DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Soft delete: a deleted post's row is kept (a Subscription's billing
  /// history may reference what a subscriber once paid for) but is excluded
  /// from every repository read — see packages/content/src/repository.ts.
  deletedAt DateTime?

  media      PostMedia[]
  contentKey ContentKey?

  @@index([creatorId, createdAt])
  @@map("posts")
}

/// A join table, not an array column on Post, because MediaAsset is
/// uploaded independently of any post ("upload-then-attach" — see
/// prompts/full.md PHASE 7) and a single asset must not be assumed to
/// belong to exactly one post forever. `mediaAssetId` now has a real FK
/// (MediaAsset didn't exist until Phase 8) — but still no writer: attaching
/// a MediaAsset to a specific Post, and deriving that post's own
/// visibility/tier as the asset's entitlement gate, is left to a future
/// phase. See docs/architecture.md's Phase 8 section for why
/// `GET /media/:id/access` doesn't need this table to already function.
model PostMedia {
  postId       String     @db.Uuid
  post         Post       @relation(fields: [postId], references: [id])
  mediaAssetId String     @db.Uuid
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id])
  sortOrder    Int        @default(0)

  @@id([postId, mediaAssetId])
  @@map("post_media")
}

enum MediaAssetStatus {
  PENDING_UPLOAD
  PROCESSING
  READY
  REJECTED
}

/// Phase 8's private media subsystem — see docs/architecture.md and
/// packages/media. A row is created (`PENDING_UPLOAD`) the moment a creator
/// requests a presigned upload URL, before the browser has uploaded
/// anything — `storageKey` is reserved up front so the presigned URL and
/// the DB row always agree on where the bytes will land. `completeUpload`
/// (packages/media/src/media.ts) moves PENDING_UPLOAD -> PROCESSING ->
/// READY/REJECTED via an injected MediaProcessor — see that interface's own
/// doc comment for why REJECTED is a hook Phase 14 plugs into without a
/// schema change, not something this phase's processor ever actually
/// returns.
///
/// Never confuse this with a public AT blob: media here lives only in
/// private, application-controlled S3-compatible object storage, never on
/// a creator's PDS — see docs/atproto-vs-database.md.
model MediaAsset {
  id String @id @default(uuid()) @db.Uuid

  creatorId String  @db.Uuid
  creator   Creator @relation(fields: [creatorId], references: [id])

  /// The object storage key/path. Reserved at PENDING_UPLOAD time, never
  /// reused across assets even if one is REJECTED — a new upload gets a new
  /// key, so a stale presigned URL can never resurrect a rejected object.
  storageKey String @unique
  mimeType   String
  /// Bytes.
  size       Int

  width    Int?
  height   Int?
  /// Seconds. Populated once real metadata extraction exists — this
  /// phase's MediaProcessor doesn't compute it (see packages/media).
  duration Int?

  status MediaAssetStatus @default(PENDING_UPLOAD)

  /// Creator-owned PDS rearchitecture: once the bytes live on the creator's
  /// PDS as a fans.foryour.media record, `sourceUri`/`sourceCid` point at
  /// that record, `pdsBlobCid` at the blob, `encrypted` says whether the
  /// blob is ciphertext, and `isAuthoritative` flips to false (S3 becomes a
  /// staging/cache copy only). Null/default on pre-rearchitecture rows.
  sourceUri       String? @unique
  sourceCid       String?
  pdsBlobCid      String?
  encrypted       Boolean @default(false)
  isAuthoritative Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  postMedia PostMedia[]

  @@index([creatorId])
  @@map("media_assets")
}

/// The atproto-oauth-client library's own "sessionStore": the DPoP-bound
/// access/refresh token material it needs to act on a DID's behalf on their
/// own PDS. This is NOT our application's login session (see Redis-backed
/// AppSession in packages/auth) — it's durable OAuth grant state, kept
/// available for background/async work even after a browser session ends.
model AtprotoOAuthSession {
  did         String   @id
  sessionData Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("atproto_oauth_sessions")
}

/// Phase 10's public discovery index — see docs/architecture.md and
/// packages/discovery. Deliberately NOT the same table as `Creator`:
/// this is a read model derived purely from what the open AT network
/// broadcasts (via Jetstream) for the fans.foryour.* collections,
/// covering ANY DID that publishes them — not only DIDs that have ever
/// signed in to this app. `Creator`/`Subscription`/`SubscriptionTier`
/// remain the only tables ever consulted for entitlement/access-control
/// decisions (canAccess) — nothing here is trustworthy enough for that:
/// it's eventually-consistent (a stream, not a synchronous write) and can
/// include DIDs this app has no operational relationship with at all.
///
/// Keyed by `did`, never `handle` — handles are mutable network metadata,
/// not identity (same rule CreatorHandleHistory encodes for our own
/// creators) — see packages/atproto/src/identity.ts#resolveDid.
model IndexedCreatorProfile {
  did         String    @id
  /// Resolved live from the DID document at index time (the profile
  /// record itself has no handle field — handle/DID are deliberately
  /// separate in AT Protocol's identity model). May be briefly stale
  /// between commits for this DID — see docs/architecture.md for why
  /// this phase doesn't also subscribe to Jetstream's `identity` events.
  handle      String?
  displayName String?
  bio         String?
  website     String?
  /// The record's own `createdAt` field, when present (see
  /// fans.foryour.profile's lexicon — none of its fields are actually
  /// required, so a real-world record could omit it).
  atCreatedAt DateTime?
  indexedAt   DateTime  @updatedAt

  @@index([handle])
  @@map("indexed_creator_profiles")
}

/// One row per public post record observed on the network. Two collections
/// land here (see prompts/bluesky-public-posts.md, docs/bluesky-public-posts.md):
///   - `fans.foryour.post` (always) — SUBSCRIBERS/TIER posts never get an AT
///     record in the first place (see docs/atproto-vs-database.md), so
///     everything indexed here was already public by construction.
///   - `app.bsky.feed.post` (only when INDEX_BSKY_POSTS is set, and then only
///     for DIDs already known to this index / the local Creator table) — the
///     paired Bluesky copy of a dual-published public post.
/// `collection` records which one a row came from; `bskyUri`/`cid` carry the
/// pairing for the merge/dedupe pass (packages/discovery/src/merge.ts).
/// `mergedFromUri` is set on a row that already represents a merged pair.
/// `uri` (`at://<did>/<collection>/<rkey>`) is the natural AT-network primary
/// key — globally unique, and exactly what a `delete` commit identifies a
/// record by.
model IndexedPost {
  uri           String    @id
  did           String
  collection    String    @default("fans.foryour.post")
  text          String
  bskyUri       String?
  cid           String?
  mergedFromUri String?
  atCreatedAt   DateTime?
  indexedAt     DateTime  @updatedAt

  @@index([did, atCreatedAt])
  @@index([collection])
  @@map("indexed_posts")
}

/// One row per fans.foryour.tier record observed on the network — public
/// tier metadata only (see that lexicon's own doc comment: explicitly
/// never billing/payout-shaped fields), independent of whether this DID
/// has a corresponding local `SubscriptionTier` row at all.
model IndexedTier {
  uri          String    @id
  did          String
  name         String
  description  String?
  monthlyPrice Int?
  currency     String?
  sortOrder    Int?
  atCreatedAt  DateTime?
  indexedAt    DateTime  @updatedAt

  @@index([did])
  @@map("indexed_tiers")
}

enum ContentKeyAudience {
  SUBSCRIBERS
  TIER
}

/// Creator-owned PDS rearchitecture — the entitlement→key-grant boundary
/// (see prompts/creator-owned-pds.md "Entitlement and Key Grants",
/// docs/creator-owned-pds.md). One row per GATED record (post body or media
/// blob) whose payload is AES-256-GCM ciphertext on the creator's PDS. The
/// per-record content key is stored ONLY envelope-wrapped
/// (`wrappedKey`, wrapped with CONTENT_KEY_WRAP_SECRET) — never in the clear,
/// and never on any AT record. This table is service-specific operational
/// state, NOT creator-authored content: it is derivable (a re-encrypt could
/// mint new keys) and must never be published.
model ContentKey {
  id String @id @default(uuid()) @db.Uuid

  creatorId String  @db.Uuid
  creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  /// The gated record this key decrypts. Exactly one of postId is set today
  /// (media keys reference the media AT URI via `subjectUri` only, since
  /// PostMedia has no writer yet — see that model's doc comment).
  postId String? @unique @db.Uuid
  post   Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)

  /// AT URI of the encrypted subject record (fans.foryour.post or
  /// fans.foryour.media). Also the conventional `keyRef` value on the record.
  subjectUri  String @unique
  subjectType String // "post" | "media"

  algorithm  String @default("AES-256-GCM")
  /// Envelope-wrapped content key, base64. Encrypted at rest — see
  /// packages/media/src/encryption.ts#wrapContentKey.
  wrappedKey String

  audience        ContentKeyAudience
  /// Set when audience is TIER — the minimum tier a grant requires.
  requiredTierId  String?            @db.Uuid
  requiredTier    SubscriptionTier?  @relation(fields: [requiredTierId], references: [id])
  accessPolicyUri String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grants ContentKeyGrant[]

  @@index([creatorId])
  @@map("content_keys")
}

/// A revocable, expiring record that a specific subscriber was handed the
/// (unwrapped) content key for a specific ContentKey. Issued ONLY after
/// packages/subscriptions/src/keyGrants.ts verifies an ACTIVE, paid-current
/// subscription at a sufficient tier. `expiresAt` bounds how long a client
/// may cache the key before re-checking entitlement; `revokedAt` is set when
/// the justifying subscription lapses. Honest about its limits: this cannot
/// un-download plaintext a subscriber already decrypted.
model ContentKeyGrant {
  id String @id @default(uuid()) @db.Uuid

  contentKeyId String     @db.Uuid
  contentKey   ContentKey @relation(fields: [contentKeyId], references: [id], onDelete: Cascade)

  subscriberUserId String @db.Uuid
  subscriberUser   User   @relation(fields: [subscriberUserId], references: [id])

  /// The subscription that justified this grant, for targeted revocation.
  subscriptionId String? @db.Uuid

  issuedAt  DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@unique([contentKeyId, subscriberUserId])
  @@index([subscriptionId])
  @@map("content_key_grants")
}

/// Jetstream resume position — see packages/discovery/src/ingestor.ts.
/// One row per ingestion source (only "jetstream" today); `cursor` is the
/// last successfully-processed event's `seq`, persisted after each event
/// so a restart resumes from there instead of replaying from the start or
/// silently skipping the gap.
model IngestionCursor {
  source    String   @id
  cursor    BigInt
  updatedAt DateTime @updatedAt

  @@map("ingestion_cursors")
}

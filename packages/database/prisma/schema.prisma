generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// The DID is the canonical identity. Never use the mutable AT handle as the
/// primary identity — `handle` and `displayName` are cached, mutable profile
/// data resolved from the user's own PDS (see prompts/full.md "Hosting model").
model User {
  id          String   @id @default(uuid()) @db.Uuid
  did         String   @unique
  handle      String?
  displayName String?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator Creator?

  @@map("users")
}

enum CreatorStatus {
  ACTIVE
  SUSPENDED
}

/// Elevated from "future work" to a real field now per prompts/full.md's
/// Phase 14 note (adult content is in scope): gates payout onboarding
/// (Phase 6) and adult-content posting (Phase 14) before those exist, so
/// this doesn't need a migration bolted on later.
enum CreatorVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
}

/// Only operational/internal fields plus a CACHE of the public AT record —
/// never the source of truth for displayName/bio/website. The source of
/// truth is the dev.creator.profile record on the creator's own PDS; see
/// docs/atproto-vs-database.md. Every write to displayName/bio/website here
/// happens only after successfully writing the AT record (write-through),
/// never before — see apps/api/src/services/creators.ts.
model Creator {
  id     String        @id @default(uuid()) @db.Uuid
  userId String        @unique @db.Uuid
  user   User          @relation(fields: [userId], references: [id])
  did    String        @unique

  slug          String    @unique
  /// null until the slug is changed for the first time — the initial pick
  /// at signup doesn't count against the change-cooldown, only a real
  /// subsequent edit does. See apps/api/src/services/creators.ts.
  slugUpdatedAt DateTime?

  /// Cached mirror of dev.creator.profile — see model doc comment above.
  displayName String?
  bio         String?
  website     String?

  status               CreatorStatus              @default(ACTIVE)
  verificationStatus   CreatorVerificationStatus   @default(UNVERIFIED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tiers SubscriptionTier[]

  @@map("creators")
}

/// Mirrors dev.creator.tier — see docs/atproto-vs-database.md. Every field
/// here except `isActive`/`atRkey` is part of that public AT record; any
/// change to name/description/priceCents/currency/sortOrder republishes it
/// (see apps/api/src/services/tiers.ts). Rows are NEVER deleted, only
/// deactivated — a future Subscription (Phase 6) references a tier's row
/// forever, including tiers a creator has since retired, and
/// SubscriptionTier.priceCents must never retroactively change what an
/// existing subscriber is billed (their agreed price is snapshotted onto
/// the Subscription row at subscribe time, not read live from here).
model SubscriptionTier {
  id        String  @id @default(uuid()) @db.Uuid
  creatorId String  @db.Uuid
  creator   Creator @relation(fields: [creatorId], references: [id])

  name        String
  description String?
  priceCents  Int
  currency    String  @db.Char(3)
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  /// The tid rkey of the corresponding dev.creator.tier record on the
  /// creator's own PDS — generated once (packages/atproto's nextTid()) and
  /// reused for every update/delete of this same record.
  atRkey String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscription_tiers")
}

/// The atproto-oauth-client library's own "sessionStore": the DPoP-bound
/// access/refresh token material it needs to act on a DID's behalf on their
/// own PDS. This is NOT our application's login session (see Redis-backed
/// AppSession in packages/auth) — it's durable OAuth grant state, kept
/// available for background/async work even after a browser session ends.
model AtprotoOAuthSession {
  did         String   @id
  sessionData Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("atproto_oauth_sessions")
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Phase 14 (Trust and Safety) — application-level RBAC, deliberately
/// minimal (two roles, no permission matrix) per prompts/full.md's
/// "do not invent... beyond what's needed". Bootstrapped from the
/// ADMIN_DIDS env var (see apps/api/src/config/env.ts and
/// packages/moderation/src/adminBootstrap.ts) — promoted idempotently on
/// login, never settable through any API route, so there is no
/// self-service or peer-to-peer path to ADMIN.
enum UserRole {
  USER
  ADMIN
}

/// Phase 14 — the "restrict account" admin action
/// (packages/moderation/src/moderationActions.ts#restrictAccount) sets this
/// to RESTRICTED. A restricted user can still authenticate and read, but
/// `requireNotRestricted` (apps/api/src/plugins/session.ts) blocks the
/// write actions capable of harming others or the platform (commenting,
/// liking, subscribing, reporting, blocking) — see that preHandler's doc
/// comment for the exact route list and why viewing/existing subscriptions
/// are deliberately left unaffected.
enum UserStatus {
  ACTIVE
  RESTRICTED
}

/// The DID is the canonical identity. Never use the mutable AT handle as the
/// primary identity — `handle` and `displayName` are cached, mutable profile
/// data resolved from the user's own PDS (see prompts/full.md "Hosting model").
model User {
  id          String   @id @default(uuid()) @db.Uuid
  did         String   @unique
  handle      String?
  displayName String?
  avatarUrl   String?
  bannerUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  role   UserRole   @default(USER)
  status UserStatus @default(ACTIVE)

  creator Creator?

  /// The active PaymentProvider's customer id for this user, created once
  /// on first subscribe and reused for every subsequent one. Nullable, not
  /// a separate table: today there's only ever one active provider (see
  /// prompts/full.md's Phase 6 note) — if that ever changes to concurrently
  /// running multiple providers, this becomes a join table then.
  paymentCustomerId String?

  subscriptions Subscription[]

  contentKeyGrants ContentKeyGrant[]

  comments Comment[]
  likes    Like[]

  /// Phase 14 — see UserBlock below. Two relations because a block is
  /// directional between two Users.
  blocksMade     UserBlock[] @relation("UserBlocksMade")
  blocksReceived UserBlock[] @relation("UserBlocksReceived")

  creatorBlocks           CreatorBlock[]
  reportsFiled            Report[]
  auditLogs               AuditLog[]
  resolvedModerationCases ModerationCase[] @relation("ModerationCaseResolvedBy")
  labelsApplied           ContentLabel[]

  @@map("users")
}

enum CreatorStatus {
  ACTIVE
  SUSPENDED
}

/// Elevated from "future work" to a real field now per prompts/full.md's
/// Phase 14 note (adult content is in scope): gates payout onboarding
/// (Phase 6) and adult-content posting (Phase 14) before those exist, so
/// this doesn't need a migration bolted on later.
enum CreatorVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
}

/// Only operational/internal fields plus a CACHE of the public AT record —
/// never the source of truth for displayName/bio/website. The source of
/// truth is the fans.foryour.profile record on the creator's own PDS; see
/// docs/atproto-vs-database.md. Every write to displayName/bio/website here
/// happens only after successfully writing the AT record (write-through),
/// never before — see apps/api/src/services/creators.ts.
///
/// There is NO app-owned name here — no slug, no username. The public
/// identity is the AT handle (cached on `User.handle`, keyed by DID); the
/// durable key is `did`. A creator's page is `/c/<handle>` or `/c/<did>`.
/// See docs/architecture.md "Creator page address".
model Creator {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id])
  did    String @unique

  /// Cached mirror of fans.foryour.profile — see model doc comment above.
  displayName String?
  bio         String?
  website     String?
  /// Site-only image overrides. Null means use the cached public AT/Bluesky
  /// image from User; setting a value never writes back to the creator's PDS.
  avatarUrl   String?
  bannerUrl   String?

  status             CreatorStatus             @default(ACTIVE)
  verificationStatus CreatorVerificationStatus @default(UNVERIFIED)

  /// Creator-owned PDS rearchitecture (see prompts/creator-owned-pds.md,
  /// docs/creator-owned-pds.md). These are cache/portability bookkeeping —
  /// null on every pre-rearchitecture row, populated by
  /// CreatorOwnedContentRepository writes and the migrate-to-pds script.
  /// `pdsUrl` is the resolved PDS service endpoint, cached for the
  /// portability panel. `profileSourceUri`/`Cid` point at the authoritative
  /// fans.foryour.profile record; `serviceConfigUri` at fans.foryour.serviceConfig.
  pdsUrl           String?
  profileSourceUri String?
  profileSourceCid String?
  serviceConfigUri String?
  pdsSyncedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tiers         SubscriptionTier[]
  subscriptions Subscription[]
  payoutAccount PayoutAccount?
  posts         Post[]
  handleHistory CreatorHandleHistory[]
  mediaAssets   MediaAsset[]
  contentKeys   ContentKey[]

  /// Phase 14 — users this creator has banned from their own content/comments.
  /// See CreatorBlock below; distinct from the generic, portable UserBlock.
  blockedUsers CreatorBlock[]

  @@map("creators")
}

/// Append-only log of AT handles a creator's DID has previously published.
/// When `syncUserFromProfile` (packages/auth) sees a creator's handle change
/// at login, it appends the *previous* handle here before overwriting
/// `User.handle`. `GET /creators/:identifier` consults it so an old
/// `/c/<oldhandle>` link 301-redirects to the current handle instead of
/// 404ing (see apps/api/src/services/creators.ts#resolveCreatorByIdentifier
/// and docs/architecture.md "Creator page address"). `did` is denormalized
/// so a stale-handle lookup needs no join. Rows are tiny and kept
/// indefinitely.
model CreatorHandleHistory {
  id             String   @id @default(uuid()) @db.Uuid
  creatorId      String   @db.Uuid
  creator        Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  did            String
  previousHandle String
  recordedAt     DateTime @default(now())

  @@index([previousHandle])
  @@index([did])
  @@map("creator_handle_history")
}

/// Mirrors fans.foryour.tier — see docs/atproto-vs-database.md. Every field
/// here except `isActive`/`atRkey` is part of that public AT record; any
/// change to name/description/priceCents/currency/sortOrder republishes it
/// (see packages/subscriptions/src/tiers.ts). Rows are NEVER deleted, only
/// deactivated — a Subscription references a tier's row forever, including
/// tiers a creator has since retired, and SubscriptionTier.priceCents must
/// never retroactively change what an existing subscriber is billed (their
/// agreed price is snapshotted onto the Subscription row at subscribe
/// time, not read live from here — see Subscription below).
model SubscriptionTier {
  id        String  @id @default(uuid()) @db.Uuid
  creatorId String  @db.Uuid
  creator   Creator @relation(fields: [creatorId], references: [id])

  name        String
  description String?
  priceCents  Int
  currency    String  @db.Char(3)
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  /// The tid rkey of the corresponding fans.foryour.tier record on the
  /// creator's own PDS — generated once (packages/atproto's nextTid()) and
  /// reused for every update/delete of this same record.
  atRkey String @unique

  /// Phase 14 — same VERIFIED-creator-only gate as Post.containsAdultContent
  /// above; a tier marked as adult content requires the creator's
  /// `verificationStatus` to be VERIFIED at the time it's set.
  containsAdultContent Boolean @default(false)

  /// Creator-owned PDS rearchitecture: the authoritative fans.foryour.tier
  /// record's AT URI/CID. Null on pre-rearchitecture rows; once set, this
  /// row is a cache (`isAuthoritative` false) of a PDS-owned record.
  sourceUri       String? @unique
  sourceCid       String?
  isAuthoritative Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
  gatedPosts    Post[]
  contentKeys   ContentKey[]

  @@map("subscription_tiers")
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

/// `provider` is a string, not an enum — the whole point of PaymentProvider
/// (packages/subscriptions/src/providers/types.ts) is that the domain isn't
/// coupled to a specific processor; only "fake" exists right now (see
/// prompts/full.md's Phase 6 note on why Stripe can't be assumed for a
/// platform that supports adult content). `priceCentsAtSubscription`/
/// `currencyAtSubscription` are the price the subscriber actually agreed to
/// — canAccess and revenue reporting must read these, never
/// `tier.priceCents` live, per the grandfathering rule (see SubscriptionTier
/// above and docs/architecture.md).
model Subscription {
  id String @id @default(uuid()) @db.Uuid

  subscriberUserId String @db.Uuid
  subscriberUser   User   @relation(fields: [subscriberUserId], references: [id])

  creatorId String  @db.Uuid
  creator   Creator @relation(fields: [creatorId], references: [id])

  tierId String           @db.Uuid
  tier   SubscriptionTier @relation(fields: [tierId], references: [id])

  status SubscriptionStatus @default(PENDING)

  provider               String
  providerSubscriptionId String?

  priceCentsAtSubscription Int
  currencyAtSubscription   String @db.Char(3)

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)

  /// Phase 15 — the `occurredAt` of the most recent webhook event actually
  /// APPLIED to this row (see packages/subscriptions/src/webhooks.ts). A
  /// second delivery whose `occurredAt` is older than this is a known
  /// out-of-order redelivery (most providers do not guarantee ordering) and
  /// is deliberately NOT applied — an old "past_due" arriving after a
  /// newer "activated" must never undo the newer state. Null until the
  /// first event carrying a timestamp has been processed.
  lastWebhookEventAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contentKeyGrants ContentKeyGrant[]

  @@unique([provider, providerSubscriptionId])
  @@index([subscriberUserId, creatorId])
  /// Phase 15 — creator-scoped queries (revenue/subscriber dashboards,
  /// packages/subscriptions/src/dashboard.ts#getCreatorDashboard) filter by
  /// `creatorId` alone; the existing composite index above is useless for
  /// that (its leading column is `subscriberUserId`).
  @@index([creatorId])
  @@map("subscriptions")
}

/// Idempotency ledger for provider webhooks — `[provider, providerEventId]`
/// is the dedupe key. `processedAt` is null the instant the row is
/// upserted and only set once side effects (Subscription status updates)
/// have actually completed, so a crash mid-processing leaves a row a retry
/// can detect and finish rather than skip — see
/// packages/subscriptions/src/webhooks.ts.
model PaymentEvent {
  id String @id @default(uuid()) @db.Uuid

  provider        String
  providerEventId String
  type            String
  payload         Json

  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([provider, providerEventId])
  @@map("payment_events")
}

enum PayoutAccountStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  RESTRICTED
}

/// One payout account per creator per provider. A creator can publish and
/// receive subscriptions while this is PENDING/NOT_STARTED — per
/// prompts/full.md's Phase 6 note, only real payout *figures* (Phase 13)
/// are gated on VERIFIED, not the ability to have subscribers at all.
model PayoutAccount {
  id String @id @default(uuid()) @db.Uuid

  creatorId String  @unique @db.Uuid
  creator   Creator @relation(fields: [creatorId], references: [id])

  provider          String
  providerAccountId String?
  status            PayoutAccountStatus @default(NOT_STARTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payout_accounts")
}

enum PostVisibility {
  PUBLIC
  SUBSCRIBERS
  TIER
}

/// The private-content model (Phase 7) — see docs/atproto-vs-database.md and
/// packages/content. `text` here is the actual body for every visibility;
/// unlike Creator/SubscriptionTier, this is NOT a cache of an AT record for
/// SUBSCRIBERS/TIER posts — for those, Postgres is the only copy, full stop
/// (see the "explicitly, permanently forbidden" list in
/// docs/atproto-vs-database.md: a paid post's body must never be publishable
/// data). Only a PUBLIC post also has a fans.foryour.post AT record, tracked
/// by `atRkey`; see packages/content/src/repository.ts for the publish/
/// retract logic on visibility transitions.
model Post {
  id String @id @default(uuid()) @db.Uuid

  creatorId String  @db.Uuid
  creator   Creator @relation(fields: [creatorId], references: [id])

  visibility PostVisibility

  /// Phase 14 — set only by a creator whose `Creator.verificationStatus` is
  /// VERIFIED; see the gating check in apps/api/src/routes/posts.ts and
  /// prompts/full.md's Phase 14 note ("the ability to mark a tier/post as
  /// containing adult content" depends on identity verification). Purely a
  /// gate on WHO may set this flag, not new visibility semantics — an
  /// adult-content post still follows `visibility` for who can see it at
  /// all. Independent of the AT-record self-label mechanism
  /// (`fans.foryour.post`'s `labels` field, com.atproto.label.defs#selfLabels)
  /// already used for PUBLIC posts — this field also gates SUBSCRIBERS/TIER
  /// posts, which never get an AT record to self-label in the first place.
  containsAdultContent Boolean @default(false)

  /// Required (and only meaningful) when visibility is TIER — the minimum
  /// SubscriptionTier (by sortOrder) required to view this post; see
  /// packages/subscriptions/src/entitlements.ts#canAccess. Null for
  /// PUBLIC/SUBSCRIBERS. Deliberately NOT cascade-restricted: a tier can be
  /// deactivated (never hard-deleted, see SubscriptionTier above) while
  /// still gating existing posts.
  minimumTierId String?           @db.Uuid
  minimumTier   SubscriptionTier? @relation(fields: [minimumTierId], references: [id])

  /// The post body. For a pre-rearchitecture row this is the only copy
  /// (SUBSCRIBERS/TIER) or a write-through cache of the fans.foryour.post
  /// record (PUBLIC). Once `isAuthoritative` is false the PDS record is the
  /// source of truth and this is a rebuildable cache — for a gated post it
  /// then holds cleartext ONLY transiently (it is cleared once the encrypted
  /// PDS record is confirmed; see CreatorOwnedContentRepository).
  text String

  /// The tid rkey of the mirrored fans.foryour.post record — set only while
  /// visibility is PUBLIC, null otherwise. Reused across edits that keep the
  /// post PUBLIC, cleared (after retracting the AT record) the moment a post
  /// stops being PUBLIC — see packages/content/src/repository.ts.
  atRkey String? @unique

  /// Creator-owned PDS rearchitecture (see prompts/creator-owned-pds.md).
  /// `sourceUri`/`sourceCid`: the authoritative fans.foryour.post record.
  /// `bskyUri`/`bskyCid`: the paired app.bsky.feed.post for a dual-published
  /// public post. `isAuthoritative` flips to false once the PDS holds the
  /// record; `indexedAt`/`cacheExpiresAt` drive cache freshness.
  /// `accessPolicyUri`: the fans.foryour.accessPolicy record for a gated post.
  sourceUri       String?   @unique
  sourceCid       String?
  bskyUri         String?   @unique
  bskyCid         String?
  /// Bluesky-public-posts refactor (prompts/bluesky-public-posts.md,
  /// docs/bluesky-public-posts.md). `bskyRkey`: the tid rkey of the paired
  /// app.bsky.feed.post — generated once and reused across edits, exactly
  /// like `atRkey` for the fans.foryour.post mirror; null unless the post is
  /// PUBLIC and dual-published. `canonicalUri`: which paired record is
  /// canonical for display/dedupe (this app always uses the fans.foryour.post
  /// URI).
  bskyRkey        String?   @unique
  canonicalUri    String?
  accessPolicyUri String?
  isAuthoritative Boolean   @default(true)
  indexedAt       DateTime?
  cacheExpiresAt  DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Soft delete: a deleted post's row is kept (a Subscription's billing
  /// history may reference what a subscriber once paid for) but is excluded
  /// from every repository read — see packages/content/src/repository.ts.
  deletedAt DateTime?

  media      PostMedia[]
  contentKey ContentKey?
  comments   Comment[]
  likes      Like[]

  @@index([creatorId, createdAt])
  @@map("posts")
}

/// Phase 12 (Comments, Likes, Social) — see prompts/full.md. A comment's
/// access is inherited entirely from its parent post: there is no
/// independent visibility/gating field here, and no gated-content check at
/// this layer at all (see apps/api/src/routes/comments.ts#loadAccessiblePost,
/// which reuses `checkPostAccess` — the exact same entitlement gate
/// GET /posts/:id already applies). Comments are Postgres-only and are
/// NEVER mirrored to AT Protocol, even for a PUBLIC post: full.md is
/// explicit that a protected post's comments must not be exposed via AT
/// unless deliberately designed to, and this phase doesn't design that —
/// applying the same rule to every comment, public post or not, keeps one
/// rule instead of a visibility-dependent one.
model Comment {
  id String @id @default(uuid()) @db.Uuid

  postId String @db.Uuid
  post   Post   @relation(fields: [postId], references: [id])

  authorUserId String @db.Uuid
  authorUser   User   @relation(fields: [authorUserId], references: [id])

  text String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Phase 14 — set only by the "remove content" admin moderation action
  /// (packages/moderation/src/moderationActions.ts#removeComment); there is
  /// still no author-initiated delete. A moderation-removed comment is
  /// excluded from `listComments` exactly like a soft-deleted Post is
  /// excluded from ContentRepository reads — see
  /// packages/content/src/comments.ts.
  deletedAt DateTime?

  @@index([postId, createdAt])
  @@map("comments")
}

/// One row per (post, user) — the `@@unique` below is what makes
/// `POST /posts/:id/likes` naturally idempotent (an upsert, not a create
/// that can collide) and `DELETE /posts/:id/likes` a safe no-op when the
/// caller never liked the post — see packages/content/src/likes.ts. Same
/// access-inherited-from-post and never-mirrored-to-AT rules as Comment.
model Like {
  id String @id @default(uuid()) @db.Uuid

  postId String @db.Uuid
  post   Post   @relation(fields: [postId], references: [id])

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@map("likes")
}

/// A join table, not an array column on Post, because MediaAsset is
/// uploaded independently of any post ("upload-then-attach" — see
/// prompts/full.md PHASE 7) and a single asset must not be assumed to
/// belong to exactly one post forever. `mediaAssetId` now has a real FK
/// (MediaAsset didn't exist until Phase 8) — but still no writer: attaching
/// a MediaAsset to a specific Post, and deriving that post's own
/// visibility/tier as the asset's entitlement gate, is left to a future
/// phase. See docs/architecture.md's Phase 8 section for why
/// `GET /media/:id/access` doesn't need this table to already function.
model PostMedia {
  postId       String     @db.Uuid
  post         Post       @relation(fields: [postId], references: [id])
  mediaAssetId String     @db.Uuid
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id])
  sortOrder    Int        @default(0)

  @@id([postId, mediaAssetId])
  @@map("post_media")
}

enum MediaAssetStatus {
  PENDING_UPLOAD
  PROCESSING
  READY
  REJECTED
}

/// Phase 8's private media subsystem — see docs/architecture.md and
/// packages/media. A row is created (`PENDING_UPLOAD`) the moment a creator
/// requests a presigned upload URL, before the browser has uploaded
/// anything — `storageKey` is reserved up front so the presigned URL and
/// the DB row always agree on where the bytes will land. `completeUpload`
/// (packages/media/src/media.ts) moves PENDING_UPLOAD -> PROCESSING ->
/// READY/REJECTED via an injected MediaProcessor — see that interface's own
/// doc comment for why REJECTED is a hook Phase 14 plugs into without a
/// schema change, not something this phase's processor ever actually
/// returns.
///
/// Never confuse this with a public AT blob: media here lives only in
/// private, application-controlled S3-compatible object storage, never on
/// a creator's PDS — see docs/atproto-vs-database.md.
model MediaAsset {
  id String @id @default(uuid()) @db.Uuid

  creatorId String  @db.Uuid
  creator   Creator @relation(fields: [creatorId], references: [id])

  /// The object storage key/path. Reserved at PENDING_UPLOAD time, never
  /// reused across assets even if one is REJECTED — a new upload gets a new
  /// key, so a stale presigned URL can never resurrect a rejected object.
  storageKey String @unique
  mimeType   String
  /// Bytes.
  size       Int

  width    Int?
  height   Int?
  /// Seconds. Populated once real metadata extraction exists — this
  /// phase's MediaProcessor doesn't compute it (see packages/media).
  duration Int?

  status MediaAssetStatus @default(PENDING_UPLOAD)

  /// Creator-owned PDS rearchitecture: once the bytes live on the creator's
  /// PDS as a fans.foryour.media record, `sourceUri`/`sourceCid` point at
  /// that record, `pdsBlobCid` at the blob, `encrypted` says whether the
  /// blob is ciphertext, and `isAuthoritative` flips to false (S3 becomes a
  /// staging/cache copy only). Null/default on pre-rearchitecture rows.
  sourceUri       String? @unique
  sourceCid       String?
  pdsBlobCid      String?
  encrypted       Boolean @default(false)
  isAuthoritative Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  postMedia PostMedia[]

  @@index([creatorId])
  @@map("media_assets")
}

/// The atproto-oauth-client library's own "sessionStore": the DPoP-bound
/// access/refresh token material it needs to act on a DID's behalf on their
/// own PDS. This is NOT our application's login session (see Redis-backed
/// AppSession in packages/auth) — it's durable OAuth grant state, kept
/// available for background/async work even after a browser session ends.
model AtprotoOAuthSession {
  did         String   @id
  sessionData Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("atproto_oauth_sessions")
}

/// Phase 10's public discovery index — see docs/architecture.md and
/// packages/discovery. Deliberately NOT the same table as `Creator`:
/// this is a read model derived purely from what the open AT network
/// broadcasts (via Jetstream) for the fans.foryour.* collections,
/// covering ANY DID that publishes them — not only DIDs that have ever
/// signed in to this app. `Creator`/`Subscription`/`SubscriptionTier`
/// remain the only tables ever consulted for entitlement/access-control
/// decisions (canAccess) — nothing here is trustworthy enough for that:
/// it's eventually-consistent (a stream, not a synchronous write) and can
/// include DIDs this app has no operational relationship with at all.
///
/// Keyed by `did`, never `handle` — handles are mutable network metadata,
/// not identity (same rule CreatorHandleHistory encodes for our own
/// creators) — see packages/atproto/src/identity.ts#resolveDid.
model IndexedCreatorProfile {
  did         String    @id
  /// Resolved live from the DID document at index time (the profile
  /// record itself has no handle field — handle/DID are deliberately
  /// separate in AT Protocol's identity model). May be briefly stale
  /// between commits for this DID — see docs/architecture.md for why
  /// this phase doesn't also subscribe to Jetstream's `identity` events.
  handle      String?
  displayName String?
  bio         String?
  website     String?
  /// The record's own `createdAt` field, when present (see
  /// fans.foryour.profile's lexicon — none of its fields are actually
  /// required, so a real-world record could omit it).
  atCreatedAt DateTime?
  indexedAt   DateTime  @updatedAt

  @@index([handle])
  @@map("indexed_creator_profiles")
}

/// One row per public post record observed on the network. Two collections
/// land here (see prompts/bluesky-public-posts.md, docs/bluesky-public-posts.md):
///   - `fans.foryour.post` (always) — SUBSCRIBERS/TIER posts never get an AT
///     record in the first place (see docs/atproto-vs-database.md), so
///     everything indexed here was already public by construction.
///   - `app.bsky.feed.post` (only when INDEX_BSKY_POSTS is set, and then only
///     for DIDs already known to this index / the local Creator table) — the
///     paired Bluesky copy of a dual-published public post.
/// `collection` records which one a row came from; `bskyUri`/`cid` carry the
/// pairing for the merge/dedupe pass (packages/discovery/src/merge.ts).
/// `mergedFromUri` is set on a row that already represents a merged pair.
/// `uri` (`at://<did>/<collection>/<rkey>`) is the natural AT-network primary
/// key — globally unique, and exactly what a `delete` commit identifies a
/// record by.
model IndexedPost {
  uri           String    @id
  did           String
  collection    String    @default("fans.foryour.post")
  text          String
  bskyUri       String?
  cid           String?
  mergedFromUri String?
  atCreatedAt   DateTime?
  indexedAt     DateTime  @updatedAt

  @@index([did, atCreatedAt])
  @@index([collection])
  @@map("indexed_posts")
}

/// One row per fans.foryour.tier record observed on the network — public
/// tier metadata only (see that lexicon's own doc comment: explicitly
/// never billing/payout-shaped fields), independent of whether this DID
/// has a corresponding local `SubscriptionTier` row at all.
model IndexedTier {
  uri          String    @id
  did          String
  name         String
  description  String?
  monthlyPrice Int?
  currency     String?
  sortOrder    Int?
  atCreatedAt  DateTime?
  indexedAt    DateTime  @updatedAt

  @@index([did])
  @@map("indexed_tiers")
}

enum ContentKeyAudience {
  SUBSCRIBERS
  TIER
}

/// Creator-owned PDS rearchitecture — the entitlement→key-grant boundary
/// (see prompts/creator-owned-pds.md "Entitlement and Key Grants",
/// docs/creator-owned-pds.md). One row per GATED record (post body or media
/// blob) whose payload is AES-256-GCM ciphertext on the creator's PDS. The
/// per-record content key is stored ONLY envelope-wrapped
/// (`wrappedKey`, wrapped with CONTENT_KEY_WRAP_SECRET) — never in the clear,
/// and never on any AT record. This table is service-specific operational
/// state, NOT creator-authored content: it is derivable (a re-encrypt could
/// mint new keys) and must never be published.
model ContentKey {
  id String @id @default(uuid()) @db.Uuid

  creatorId String  @db.Uuid
  creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  /// The gated record this key decrypts. Exactly one of postId is set today
  /// (media keys reference the media AT URI via `subjectUri` only, since
  /// PostMedia has no writer yet — see that model's doc comment).
  postId String? @unique @db.Uuid
  post   Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)

  /// AT URI of the encrypted subject record (fans.foryour.post or
  /// fans.foryour.media). Also the conventional `keyRef` value on the record.
  subjectUri  String @unique
  subjectType String // "post" | "media"

  algorithm  String @default("AES-256-GCM")
  /// Envelope-wrapped content key, base64. Encrypted at rest — see
  /// packages/media/src/encryption.ts#wrapContentKey.
  wrappedKey String

  audience        ContentKeyAudience
  /// Set when audience is TIER — the minimum tier a grant requires.
  requiredTierId  String?            @db.Uuid
  requiredTier    SubscriptionTier?  @relation(fields: [requiredTierId], references: [id])
  accessPolicyUri String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grants ContentKeyGrant[]

  @@index([creatorId])
  @@map("content_keys")
}

/// A revocable, expiring record that a specific subscriber was handed the
/// (unwrapped) content key for a specific ContentKey. Issued ONLY after
/// packages/subscriptions/src/keyGrants.ts verifies an ACTIVE, paid-current
/// subscription at a sufficient tier. `expiresAt` bounds how long a client
/// may cache the key before re-checking entitlement; `revokedAt` is set when
/// the justifying subscription lapses. Honest about its limits: this cannot
/// un-download plaintext a subscriber already decrypted.
model ContentKeyGrant {
  id String @id @default(uuid()) @db.Uuid

  contentKeyId String     @db.Uuid
  contentKey   ContentKey @relation(fields: [contentKeyId], references: [id], onDelete: Cascade)

  subscriberUserId String @db.Uuid
  subscriberUser   User   @relation(fields: [subscriberUserId], references: [id])

  /// The subscription that justified this grant, for targeted revocation.
  /// Phase 15 — was a bare uuid column with no FK (referential integrity
  /// gap: nothing stopped this from pointing at a nonexistent Subscription
  /// row); now a real relation. `onDelete: SetNull` rather than the default
  /// Restrict — Subscription rows are never hard-deleted today (see that
  /// model's own doc comment), but a grant's revocation record must not
  /// block one from ever being deleted in the future.
  subscriptionId String?       @db.Uuid
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  issuedAt  DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@unique([contentKeyId, subscriberUserId])
  @@index([subscriptionId])
  @@map("content_key_grants")
}

/// Jetstream resume position — see packages/discovery/src/ingestor.ts.
/// One row per ingestion source (only "jetstream" today); `cursor` is the
/// last successfully-processed event's `seq`, persisted after each event
/// so a restart resumes from there instead of replaying from the start or
/// silently skipping the gap.
model IngestionCursor {
  source    String   @id
  cursor    BigInt
  updatedAt DateTime @updatedAt

  @@map("ingestion_cursors")
}

// ---------------------------------------------------------------------------
// Phase 14 — Trust and Safety Foundation (see prompts/full.md, docs/architecture.md)
// ---------------------------------------------------------------------------
//
// Design note on AT Protocol reuse (docs/architecture.md has the full writeup):
// this platform is already deeply AT-Protocol-native (creator profiles/tiers/
// posts are real records on the creator's own PDS; PUBLIC posts dual-publish
// as app.bsky.feed.post). Phase 14 continues that discipline where the
// concept is genuinely public, portable identity-graph data:
//
//   - UserBlock writes a REAL `app.bsky.graph.block` record (the same one
//     Bluesky itself uses) to the blocker's own PDS — see
//     packages/atproto/src/bskyBlock.ts. A block a subscriber makes here
//     also takes effect on Bluesky/any AT client, for free, and is never
//     "ours" to lose if they leave.
//   - ContentLabel's shape is a field-for-field match of the core protocol's
//     `com.atproto.label.defs#label` (already vendored — see
//     packages/lexicons/lexicons/com/atproto/label/defs.json, already used
//     by fans.foryour.post's creator self-labels). This is NOT currently
//     exposed as a real labeler service (no `com.atproto.label.subscribeLabels`
//     WebSocket, no labeler DID) — that's a documented future extension, not
//     a schema change, exactly like Phase 8's MediaProcessor hook.
//
// Report/ModerationCase/CreatorBlock/AuditLog are operational/internal by
// nature (a report contains an accusation and a reporter identity; an audit
// log entry is who-did-what-to-whom on OUR platform) — see
// docs/atproto-vs-database.md's classification table, extended below. These
// are Postgres-only, same bucket as Subscription/PaymentEvent/PayoutAccount.

/// Polymorphic subject discriminator shared by Report/ModerationCase/
/// ContentLabel/AuditLog. `subjectId` is an opaque uuid string with NO
/// database-level foreign key (Prisma has no native polymorphic relation) —
/// application code (packages/moderation) resolves and validates it against
/// the right table for the given `subjectType` before ever writing a row.
enum ModerationSubjectType {
  CREATOR
  USER
  POST
  COMMENT
}

/// Loosely aligned with the public network's own
/// `com.atproto.moderation.defs` reasonType vocabulary (spam/violation/
/// misleading/sexual/rude/other) where a category actually overlaps, plus
/// platform-specific categories prompts/full.md's Phase 14 note explicitly
/// calls out as needing distinct escalation paths (NCII, illegal content,
/// copyright) — see docs/architecture.md for the full mapping table and
/// which of these set `ModerationCase.requiresLegalReview`.
enum ReportReason {
  SPAM
  HARASSMENT
  IMPERSONATION
  SEXUAL_CONTENT_VIOLATION
  NCII
  COPYRIGHT
  ILLEGAL_CONTENT
  OTHER
}

/// A user-filed report — the request shape (subject + reasonType + free-text
/// reason) mirrors `com.atproto.moderation.createReport` for the same
/// portability reason as UserBlock: if this platform ever proxies reports to
/// or from a real AT Protocol moderation service (e.g. an Ozone-compatible
/// labeler), the field shapes already agree. Transport-wise this is our own
/// REST endpoint, not XRPC — reports about private, gated content and about
/// accusations against real people are not broadcast-appropriate data, so
/// this is Postgres-only, never an AT record (see the file-level note above).
///
/// Every report is attached to a ModerationCase at creation time
/// (`moderationCaseId` is NOT NULL) — `createReport`
/// (packages/moderation/src/reports.ts) finds the subject's existing OPEN
/// case or opens a new one, so repeat reports about the same subject
/// accumulate onto one case instead of scattering across many, matching how
/// real-world moderation queues (including Ozone's) work.
model Report {
  id String @id @default(uuid()) @db.Uuid

  reporterUserId String @db.Uuid
  reporterUser   User   @relation(fields: [reporterUserId], references: [id])

  subjectType ModerationSubjectType
  subjectId   String

  reasonType ReportReason
  /// Free-text context, capped well under com.atproto.moderation.createReport's
  /// own 20,000-character limit — see createReportBodySchema in
  /// apps/api/src/routes/reports.ts.
  reason     String?

  moderationCaseId String         @db.Uuid
  moderationCase   ModerationCase @relation(fields: [moderationCaseId], references: [id])

  createdAt DateTime @default(now())

  @@index([subjectType, subjectId])
  @@index([moderationCaseId])
  @@map("reports")
}

enum ModerationCaseStatus {
  OPEN
  ACTION_TAKEN
  DISMISSED
}

/// One row per (subjectType, subjectId) under active or past moderation
/// review — modeled after the "subject status" concept real-world AT
/// Protocol moderation tooling (Ozone) uses: reports accumulate onto a
/// case, and every admin action taken against the subject is logged
/// (AuditLog) against that same case, giving one place to see a subject's
/// full moderation history. At most one OPEN case per subject is an
/// application-level invariant (packages/moderation/src/cases.ts#findOrOpenCase),
/// not a DB constraint — Prisma can't express a partial-unique-index this
/// schema-portably, and history (past DISMISSED/ACTION_TAKEN cases) must
/// still coexist with a later new OPEN one for the same subject.
model ModerationCase {
  id String @id @default(uuid()) @db.Uuid

  subjectType ModerationSubjectType
  subjectId   String

  status ModerationCaseStatus @default(OPEN)

  /// Set true if ANY linked report's reasonType is one prompts/full.md's
  /// Phase 14 note flags for mandatory external escalation (NCII,
  /// ILLEGAL_CONTENT) — surfaced prominently to admins
  /// (GET /admin/cases). Do NOT read this as "this app files the legal/
  /// NCMEC/DMCA report automatically" — it does not; see
  /// docs/architecture.md's "Legal/compliance review required" section for
  /// what's explicitly NOT implemented here.
  requiresLegalReview Boolean @default(false)

  /// Populated by the injected ContentClassifier hook at report-creation
  /// time (packages/moderation/src/classifiers/types.ts) — an
  /// automated-triage SUGGESTION for the admin reviewing this case, never
  /// acted on automatically. Null when no classifier is configured or it
  /// found nothing to flag; PassthroughContentClassifier (the only
  /// implementation that exists today) always returns null, exactly like
  /// Phase 8's PassthroughMediaProcessor never actually scans anything.
  classifierSuggestion Json?

  resolvedByUserId String?   @db.Uuid
  resolvedByUser   User?     @relation("ModerationCaseResolvedBy", fields: [resolvedByUserId], references: [id])
  resolutionNote   String?
  resolvedAt       DateTime?

  openedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  reports   Report[]
  labels    ContentLabel[]
  auditLogs AuditLog[]

  @@index([subjectType, subjectId])
  @@index([status])
  @@map("moderation_cases")
}

/// Moderator/classifier-applied content labels — deliberately shaped to
/// match `com.atproto.label.defs#label` field-for-field (src/uri/val/neg/
/// cts/exp) rather than an ad hoc schema, so a row here could be published
/// via a real `com.atproto.label.subscribeLabels`-compatible labeler service
/// with no field renaming if that's ever built (see the file-level note
/// above and docs/architecture.md). This is DISTINCT from a creator's own
/// self-labels on `fans.foryour.post` (`labels` field, Phase 3) — those are
/// creator-declared content warnings on a public AT record; these are
/// moderator- or classifier-applied, cover every subject type (including
/// SUBSCRIBERS/TIER posts and comments that never get an AT record at all),
/// and are never written by the subject's own creator.
///
/// To retract a label, insert a NEW row with `neg: true` for the same
/// (subjectType, subjectId, val) rather than mutating the original — this is
/// exactly how the real label protocol represents retraction (see the `neg`
/// field's doc comment on com.atproto.label.defs#label), so there is
/// deliberately no `updatedAt` here.
model ContentLabel {
  id String @id @default(uuid()) @db.Uuid

  subjectType ModerationSubjectType
  subjectId   String
  /// AT URI of the subject record, when one exists (a PUBLIC post/creator
  /// profile) — populated so a future real labeler export needs no lookup.
  /// Null for SUBSCRIBERS/TIER posts and comments (no AT record exists).
  subjectUri  String?

  /// The label value — com.atproto.label.defs's own vocabulary (`porn`,
  /// `sexual`, `nudity`, `graphic-media`, …) where it applies, plus
  /// platform-specific extensions defined in
  /// packages/moderation/src/labels.ts (e.g. `ncii-review`, `takedown`,
  /// `spam`) — custom label values are a normal, expected part of the
  /// labeler system, not a deviation from it.
  val String
  /// The labeler identity ("src" in the wire format) — a stable service
  /// identifier for this platform's moderation service, NOT a real,
  /// network-registered labeler DID (this app doesn't operate one — see
  /// docs/architecture.md). Kept as its own field (rather than hardcoded at
  /// read time) so a future real labeler DID is a one-place change.
  src String    @default("foryour.fans-moderation")
  neg Boolean   @default(false)
  cts DateTime  @default(now())
  exp DateTime?

  moderationCaseId String?         @db.Uuid
  moderationCase   ModerationCase? @relation(fields: [moderationCaseId], references: [id])

  /// Null when applied by an automated classifier rather than a human admin.
  appliedByUserId String? @db.Uuid
  appliedByUser   User?   @relation(fields: [appliedByUserId], references: [id])

  @@index([subjectType, subjectId])
  @@map("content_labels")
}

/// A real `app.bsky.graph.block` record (see packages/atproto/src/bskyBlock.ts
/// and the file-level note above), mint-once/reuse-rkey/retract-on-unblock —
/// same AT-write-first discipline as SubscriptionTier: `blockUser`
/// (packages/moderation/src/blocks.ts) publishes the AT record BEFORE this
/// row is written, and `unblockUser` deletes the AT record before this row
/// is removed. A generic, symmetric, portable user-to-user block — filters
/// the blocked party out of the blocker's feed/comments/discovery locally
/// (packages/moderation/src/blocks.ts#isBlockedEitherWay), independent of
/// any creator/subscriber relationship between them. Distinct from
/// CreatorBlock below.
model UserBlock {
  id String @id @default(uuid()) @db.Uuid

  blockerUserId String @db.Uuid
  blockerUser   User   @relation("UserBlocksMade", fields: [blockerUserId], references: [id])

  blockedUserId String @db.Uuid
  blockedUser   User   @relation("UserBlocksReceived", fields: [blockedUserId], references: [id])

  /// The app.bsky.graph.block record on the blocker's own PDS.
  atUri  String @unique
  atCid  String
  atRkey String @unique

  createdAt DateTime @default(now())

  @@unique([blockerUserId, blockedUserId])
  @@map("user_blocks")
}

/// A creator-specific ban from that creator's own content/comments — an
/// app-only business rule with no AT Protocol equivalent (there is no
/// "blocked from my paid content" concept on the open network), so this is
/// Postgres-only, same bucket as Subscription. Distinct from UserBlock:
/// blocking a creator here does not affect what the blocked user sees
/// elsewhere on the platform, and does not block the creator's ability to
/// see or interact with the blocked user in return.
model CreatorBlock {
  id String @id @default(uuid()) @db.Uuid

  creatorId String  @db.Uuid
  creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  blockedUserId String @db.Uuid
  blockedUser   User   @relation(fields: [blockedUserId], references: [id])

  reason String?

  createdAt DateTime @default(now())

  @@unique([creatorId, blockedUserId])
  @@map("creator_blocks")
}

enum AuditAction {
  CASE_DISMISSED
  CONTENT_REMOVED
  ACCOUNT_RESTRICTED
  ACCOUNT_REINSTATED
  CREATOR_SUSPENDED
  CREATOR_REINSTATED
  LABEL_APPLIED
  LABEL_REMOVED
  CREATOR_VERIFICATION_SUBMITTED
  CREATOR_VERIFICATION_APPROVED
  CREATOR_VERIFICATION_REJECTED
}

/// Append-only trail of every sensitive moderation action — never updated or
/// deleted by any code path in this codebase (enforced by convention, since
/// Prisma/Postgres can't make a table immutable on their own; see
/// packages/moderation for the only writers). `actorUserId` is null only for
/// a future automated-classifier-driven action (none exists today — every
/// action currently logged here is admin-initiated); `actorRole` snapshots
/// the acting user's role AT THE TIME of the action, since `User.role` is
/// mutable and a later demotion must not rewrite history.
model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  actorUserId String? @db.Uuid
  actorUser   User?   @relation(fields: [actorUserId], references: [id])
  actorRole   String

  action AuditAction

  targetType ModerationSubjectType
  targetId   String

  moderationCaseId String?         @db.Uuid
  moderationCase   ModerationCase? @relation(fields: [moderationCaseId], references: [id])

  /// Action-specific structured detail — e.g. { "previousStatus": "ACTIVE" }
  /// for CREATOR_SUSPENDED, { "val": "ncii-review" } for LABEL_APPLIED.
  metadata Json?

  createdAt DateTime @default(now())

  @@index([targetType, targetId])
  @@index([moderationCaseId])
  @@map("audit_logs")
}

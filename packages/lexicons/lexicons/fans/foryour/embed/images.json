{
  "lexicon": 1,
  "id": "fans.foryour.embed.images",
  "description": "A set of images embedded in a fans.foryour.post record.",
  "defs": {
    "main": {
      "type": "object",
      "required": ["images"],
      "properties": {
        "images": {
          "type": "array",
          "items": { "type": "ref", "ref": "#image" },
          "maxLength": 4
        }
      }
    },
    "image": {
      "type": "object",
      "required": ["image", "alt"],
      "properties": {
        "image": {
          "type": "blob",
          "description": "Uploaded to the creator's own PDS — public post media only. Subscriber-only media never goes through this lexicon; see PHASE 7/8 in prompts/full.md.",
          "accept": ["image/png", "image/jpeg", "image/webp"],
          "maxSize": 4000000
        },
        "alt": {
          "type": "string",
          "description": "Alt text, for accessibility.",
          "maxLength": 2000
        },
        "aspectRatio": {
          "type": "ref",
          "ref": "#aspectRatio"
        }
      }
    },
    "aspectRatio": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    }
  }
}

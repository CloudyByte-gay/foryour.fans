# --- apps/api ---
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Matches infrastructure/docker/docker-compose.yml
DATABASE_URL=postgresql://foryour_fans:foryour_fans@localhost:5432/foryour_fans
REDIS_URL=redis://localhost:6379

# The single public origin the web app is served from. AT OAuth requires
# this to be reachable at http://127.0.0.1:3000 specifically (not
# "localhost") in dev — see packages/atproto/src/oauthClient.ts and
# docs/architecture.md for why. CORS_ORIGIN should normally match this.
PUBLIC_URL=http://127.0.0.1:3000
CORS_ORIGIN=http://127.0.0.1:3000

# loopback (dev-only, no keys needed) | hosted (production — requires
# ATPROTO_OAUTH_PRIVATE_KEY and a real PUBLIC_URL serving the client
# metadata/jwks endpoints over HTTPS)
ATPROTO_OAUTH_MODE=loopback
# ATPROTO_OAUTH_PRIVATE_KEY=

# Phase 15 (Production Hardening) — "fake" is the only value that exists,
# because no real payment/payout processor has been selected yet (see
# prompts/full.md's Phase 6 note). loadEnv REFUSES to boot with either set
# to "fake" under NODE_ENV=production — see apps/api/src/config/env.ts —
# so this is, honestly, "production is not deployable for real money yet,"
# not a config knob to change on your own.
PAYMENT_PROVIDER=fake
PAYOUT_PROVIDER=fake

# S3-compatible private object storage for media (Phase 8) — MinIO in local
# dev. The local bucket isn't auto-created; run this once after
# `docker compose up`:
#   docker exec foryour-fans-minio-1 mc alias set local http://localhost:9000 foryour_fans foryour_fans_dev
#   docker exec foryour-fans-minio-1 mc mb local/foryour-fans-dev --ignore-existing
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=foryour_fans
S3_SECRET_ACCESS_KEY=foryour_fans_dev
S3_BUCKET=foryour-fans-dev
# MinIO/most non-AWS S3-compatible providers require path-style addressing.
S3_FORCE_PATH_STYLE=true

# Jetstream source for AT-network public discovery (Phase 10) — only read
# by `pnpm --filter @foryour-fans/api dev:ingest`, a separate process from
# the API server. The default is a real, public production endpoint —
# verified directly (see docs/architecture.md's Phase 10 section) since
# the wire format Jetstream actually serves in production differs from
# what some of its own documentation currently describes.
JETSTREAM_URL=wss://jetstream.us-east.bsky.network/subscribe

# Bluesky-public-posts refactor (prompts/bluesky-public-posts.md). When true,
# the `dev:ingest` process ALSO subscribes to `app.bsky.feed.post` so the
# paired Bluesky copy of a dual-published public post is indexed. OFF by
# default: wantedCollections can't scope to a DID, so this ingests the whole
# Bluesky firehose (the indexer still drops events for DIDs it doesn't track).
INDEX_BSKY_POSTS=false

# Creator-owned PDS rearchitecture (prompts/creator-owned-pds.md,
# docs/creator-owned-pds.md). Both OFF by default — Phases 1–10 behaviour is
# unchanged until the privacy review signs off.
#
#   CREATOR_OWNED_PDS_ENABLED         use CreatorOwnedContentRepository:
#                                     public posts become dual-published,
#                                     creator-PDS-authoritative records and
#                                     Postgres a rebuildable cache.
#   CREATOR_OWNED_GATED_CONTENT_ENABLED  additionally write GATED post bodies
#                                     to the creator's PDS, AES-256-GCM-
#                                     encrypted, with the key-grant flow.
#                                     Requires CREATOR_OWNED_PDS_ENABLED and
#                                     CONTENT_KEY_WRAP_SECRET. Not production-
#                                     safe yet — see docs/creator-owned-pds.md
#                                     §4/§7. Leave off outside local dev.
#   CONTENT_KEY_WRAP_SECRET           >=16 chars; envelope-wraps per-post
#                                     content keys at rest. Treat like a
#                                     signing key.
CREATOR_OWNED_PDS_ENABLED=false
CREATOR_OWNED_GATED_CONTENT_ENABLED=false
# CONTENT_KEY_WRAP_SECRET=

# Phase 14 (Trust and Safety) — comma-separated DIDs promoted to
# User.role: "ADMIN" on login, unlocking the /admin moderation console
# (apps/api/src/routes/admin.ts). This is the ONLY way to become an admin —
# no API route, no self-service flow. Empty by default: a fresh checkout has
# zero admins until an operator sets this to their own DID(s).
# ADMIN_DIDS=did:plc:youradminaccount

# --- apps/web ---
# Server-side only: where apps/web's Next.js server proxies /api/* to.
# Never exposed to the browser (browser calls same-origin /api/* instead).
API_INTERNAL_URL=http://127.0.0.1:4000

# --- apps/api ---
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Matches infrastructure/docker/docker-compose.yml
DATABASE_URL=postgresql://foryour_fans:foryour_fans@localhost:5432/foryour_fans
REDIS_URL=redis://localhost:6379

# The single public origin the web app is served from. AT OAuth requires
# this to be reachable at http://127.0.0.1:3000 specifically (not
# "localhost") in dev — see packages/atproto/src/oauthClient.ts and
# docs/architecture.md for why. CORS_ORIGIN should normally match this.
PUBLIC_URL=http://127.0.0.1:3000
CORS_ORIGIN=http://127.0.0.1:3000

# loopback (dev-only, no keys needed) | hosted (production — requires
# ATPROTO_OAUTH_PRIVATE_KEY and a real PUBLIC_URL serving the client
# metadata/jwks endpoints over HTTPS)
ATPROTO_OAUTH_MODE=loopback
# ATPROTO_OAUTH_PRIVATE_KEY=

# S3-compatible private object storage for media (Phase 8) — MinIO in local
# dev. The local bucket isn't auto-created; run this once after
# `docker compose up`:
#   docker exec foryour-fans-minio-1 mc alias set local http://localhost:9000 foryour_fans foryour_fans_dev
#   docker exec foryour-fans-minio-1 mc mb local/foryour-fans-dev --ignore-existing
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=foryour_fans
S3_SECRET_ACCESS_KEY=foryour_fans_dev
S3_BUCKET=foryour-fans-dev
# MinIO/most non-AWS S3-compatible providers require path-style addressing.
S3_FORCE_PATH_STYLE=true

# Jetstream source for AT-network public discovery (Phase 10) — only read
# by `pnpm --filter @foryour-fans/api dev:ingest`, a separate process from
# the API server. The default is a real, public production endpoint —
# verified directly (see docs/architecture.md's Phase 10 section) since
# the wire format Jetstream actually serves in production differs from
# what some of its own documentation currently describes.
JETSTREAM_URL=wss://jetstream.us-east.bsky.network/subscribe

# --- apps/web ---
# Server-side only: where apps/web's Next.js server proxies /api/* to.
# Never exposed to the browser (browser calls same-origin /api/* instead).
API_INTERNAL_URL=http://127.0.0.1:4000

# Template for infrastructure/docker/docker-compose.prod.yml — see
# docs/deployment-vps.md for the full walkthrough. Copy to `.env.prod` next
# to this file, fill in every value, and never commit the real file
# (.gitignore already excludes .env*).
#
# The AT OAuth signing key (ATPROTO_OAUTH_PRIVATE_KEY) is NOT set here — a
# PEM with real newlines doesn't survive .env parsing reliably across
# tooling. It's mounted as a file instead; see docs/deployment-vps.md
# Step 5.

# --- domain / TLS ---
DOMAIN=example.com
ACME_EMAIL=you@example.com

# --- Postgres ---
POSTGRES_PASSWORD=CHANGE_ME_use_openssl_rand_-hex_24

# --- Redis ---
# Not published to the host — this is defense-in-depth on the internal
# Docker network, not the only thing standing between the internet and it.
REDIS_PASSWORD=CHANGE_ME_use_openssl_rand_-hex_24

# --- MinIO (self-hosted S3-compatible media storage) ---
MINIO_ROOT_USER=foryour_fans
MINIO_ROOT_PASSWORD=CHANGE_ME_use_openssl_rand_-hex_24
S3_BUCKET=foryour-fans-media

# --- app ---
# Comma-separated DIDs that become ADMIN on login — the only path to admin.
# Leave empty until you know your own DID (log in once, then set this and
# restart the api/ingest services).
ADMIN_DIDS=

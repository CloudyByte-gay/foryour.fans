# Copy to terraform.tfvars and fill in. Secrets can instead be passed as
# TF_VAR_* environment variables (e.g. export TF_VAR_admin_dids=...).

project_id = "your-gcp-project"
region     = "us-central1"
zone       = "us-central1-b"

site_url = "https://foryour.fans"

# Redis. Default: Terraform provisions a private-VPC Memorystore instance
# (redis.tf, ~$35/mo BASIC 1GB). To use an external endpoint (e.g. Upstash
# free tier) instead, uncomment both lines below.
# create_redis = false
# redis_url    = "rediss://default:TOKEN@your-db.upstash.io:6379"

# Comma-separated AT Protocol DIDs promoted to ADMIN on login. Empty = none.
admin_dids = ""

# ---- GitHub Actions image builds (keyless, via WIF — github-wif.tf) ----
# On by default. After `terraform apply`, run `terraform output
# github_actions_setup` and set the six values on the repo. Set to false to
# skip provisioning the pool / provider / ffans-ci service account.
# enable_github_wif = true
# github_repo       = "CloudyByte-gay/foryour.fans"

# ---- first apply only ----
# Leave deploy_services = false, apply, build & push images, then set the
# three image refs, flip deploy_services = true, and apply again.
deploy_services   = false
api_image         = "" # e.g. us-central1-docker.pkg.dev/your-gcp-project/foryour-fans/api:abc1234
api_migrate_image = "" # e.g. ...:abc1234-migrate
web_image         = "" # e.g. ...:web:abc1234  (built with --build-arg API_INTERNAL_URL=<api_url>)

# ---- optional ----
domain          = ""            # custom domain for the web service (no scheme)
billing_account = ""            # e.g. 012345-6789AB-CDEF01, to create a budget alert
budget_alert_emails = []        # ["you@example.com"]

# ---- DNS via Cloudflare (optional; requires domain) ----
# Terraform writes the Cloud Run domain-mapping records into your Cloudflare
# zone instead of you adding them by hand. Pass the token as
# TF_VAR_cloudflare_api_token rather than committing it here.
# manage_dns           = true
# cloudflare_api_token = ""     # token with Zone:Read + DNS:Edit on the zone
# cloudflare_zone_id   = ""     # Cloudflare dashboard -> domain -> API (sidebar)
# dns_zone             = ""     # zone apex; leave empty when domain IS the apex
# cloudflare_proxied   = false  # keep false until the cert is provisioned

# ---- sizing (bump as you grow — see docs/deployment-gcp.md "Scaling") ----
db_tier              = "db-f1-micro"
db_availability_type = "ZONAL"
api_min_instances    = 0
web_min_instances    = 0
web_max_instances    = 4

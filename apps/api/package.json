{
  "name": "@foryour-fans/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:ingest": "tsx watch src/ingest.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:ingest": "node dist/ingest.js",
    "migrate:pds": "node dist/scripts/migrateToPds.js",
    "lint": "eslint -c ../../eslint.config.js src test --max-warnings=0",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@atproto/oauth-client-node": "^0.5.4",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^10.0.1",
    "@foryour-fans/atproto": "workspace:*",
    "@foryour-fans/auth": "workspace:*",
    "@foryour-fans/content": "workspace:*",
    "@foryour-fans/database": "workspace:*",
    "@foryour-fans/discovery": "workspace:*",
    "@foryour-fans/lexicons": "workspace:*",
    "@foryour-fans/media": "workspace:*",
    "@foryour-fans/moderation": "workspace:*",
    "@foryour-fans/shared": "workspace:*",
    "@foryour-fans/subscriptions": "workspace:*",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "ioredis": "^6.0.0",
    "pino": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
